// Fonts
$font-main: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
$font-mono: 'Courier New', Courier, monospace;

// Light Theme
$bg-light: #ffffff;
$bg-secondary-light: #f8f9fa;
$text-light: #212529;
$text-secondary-light: #6c757d;
$primary-light: #0d6efd;
$primary-hover-light: #0b5ed7;
$success-light: #198754;
$danger-light: #dc3545;
$warning-light: #ffc107;
$border-light: #dee2e6;
$card-light: #ffffff;
$shadow-light: rgba(0, 0, 0, 0.1);

// Dark Theme
$bg-dark: #0d1117;
$bg-secondary-dark: #161b22;
$text-dark: #e6edf3;
$text-secondary-dark: #7d8590;
$primary-dark: #2f81f7;
$primary-hover-dark: #58a6ff;
$success-dark: #3fb950;
$danger-dark: #f85149;
$warning-dark: #d29922;
$border-dark: #30363d;
$card-dark: #161b22;
$shadow-dark: rgba(0, 0, 0, 0.4);

// Spacing
$spacing-xs: 0.25rem;
$spacing-sm: 0.5rem;
$spacing-md: 1rem;
$spacing-lg: 1.5rem;
$spacing-xl: 2rem;
$spacing-xxl: 3rem;

// Border radius
$radius-sm: 4px;
$radius-md: 8px;
$radius-lg: 12px;

// Transitions
$transition-fast: 0.15s ease;
$transition-normal: 0.3s ease;
$transition-lento: 0.5s ease;


// OLDs

// ============================================
// VARIABLES CSS GLOBALES
// ============================================

:root {

    // Terminal (NO cambian con theme)
    --primary-color: #b3ff00;
    --background-color: #0c0c0c;
    --header-color: #2a2a2a;
    --error-color: #ff6b6b;
    --warning-color: #ffff00;
    --info-color: #00dddd;


    // Terminal dimensiones/efectos
    --font-family: "JetBrains Mono", "Courier New", monospace;
    --font-size: 14px;
    --border-radius: 8px;
    --max-width: 90vw;
    --min-height: 70vh;
    --max-height: 85vh;
    --glow-intensity: 0.3;
    --transition-speed: 0.3s;
    --shadow-depth: 30px;
}




// Theme variables - SOLO para body background y navbar
:root {

    --app-bg-primary: rgb(19, 20, 20);
    --app-bg-secondary: #1a1a1a;
    --navbar-text: #ffffff;
    --navbar-accent: #b3ff00;
    --navbar-accent-hover: #82b803;
    --navbar-border: rgb(235, 234, 219);
}

[data-theme="light"] {

    --app-bg-primary: rgb(228, 227, 227);

    --app-bg-secondary:  rgb(230, 235, 219);
    --navbar-text: #333333;
    --navbar-accent: #7c0053;
    --navbar-accent-hover: #5c0056;
    --navbar-border: rgb(19, 20, 20);

}




// Z-index scale - ESTA VARIABLE FALTABA
$z-index: (
    modal: 1000,
    dropdown: 100,
    fixed: 50,
    nav: 10,
    base: 1
);

